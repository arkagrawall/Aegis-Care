<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light only: every colour in the app is designed for a light surface -->
    <style name="Theme.AegisSaathi" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_soft</item>
        <item name="android:fontFamily">@font/mukta</item>
        <item name="fontFamily">@font/mukta</item>
    </style>

    <!-- Dark call screens -->
    <style name="Theme.AegisSaathi.Call" parent="Theme.AegisSaathi">
        <item name="android:windowBackground">@color/call_top</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
