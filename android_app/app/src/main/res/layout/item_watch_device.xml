<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <ImageView
        android:id="@+id/ivDevice"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_circle_primary_soft"
        android:importantForAccessibility="no"
        android:padding="10dp"
        app:srcCompat="@drawable/ic_watch"
        app:tint="@color/primary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDeviceName"
            style="@style/T.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tvDeviceMeta"
            style="@style/T.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnDeviceConnect"
        style="@style/T.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
            android:minHeight="56dp"
        android:background="@drawable/bg_btn_primary"
        android:clickable="true"
        android:focusable="true"
        android:minWidth="88dp"
        android:paddingHorizontal="16dp"
        android:text="@string/watch_connect"
        android:textSize="18sp" />
</LinearLayout>
