<?xml version="1.0" encoding="utf-8"?>
<!-- Ringing screen for seniors: who is calling, why, and two large plain-tap buttons. No swipe gestures. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_call_gradient"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="40dp"
    android:paddingBottom="32dp">

    <LinearLayout
        android:id="@+id/tvIncomingBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_status_chip"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_wave"
            app:tint="@color/call_accent" />

        <TextView
            style="@style/T.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/inc_badge"
            android:textColor="@color/call_ink" />
    </LinearLayout>

    <!-- Avatar with soft pulsing rings -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="180dp">

        <View
            android:id="@+id/ring1"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_caller_ripple_outer"
            android:importantForAccessibility="no" />

        <View
            android:id="@+id/ring2"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_caller_ripple_outer"
            android:importantForAccessibility="no" />

        <View
            android:id="@+id/ring3"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_caller_ripple_outer"
            android:importantForAccessibility="no" />

        <FrameLayout
            android:id="@+id/avatarContainer"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_caller_avatar_circle"
            android:importantForAccessibility="no">

            <ImageView
                android:id="@+id/ivAvatar"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_logo"
                app:tint="@color/call_ink" />
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/tvCallerName"
        style="@style/T.Display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/inc_name"
        android:textColor="@color/call_ink"
        android:textSize="34sp" />

    <TextView
        android:id="@+id/tvCallSubtitle"
        style="@style/T.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/inc_sub"
        android:textColor="@color/call_ink_soft"
        android:textSize="20sp" />

    <!-- Decline: smaller, outlined, above. Answer: the big green one at the bottom, under the thumb. -->
    <LinearLayout
        android:id="@+id/btnDeclineCall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_pill_decline"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_phone_end"
            app:tint="#FF8A80" />

        <TextView
            style="@style/T.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/inc_decline_long"
            android:textColor="@color/call_ink"
            android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnAcceptCall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_pill_answer"
        android:clickable="true"
        android:elevation="6dp"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="88dp"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp">

        <ImageView
            android:id="@+id/ivAcceptIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_phone"
            app:tint="@color/call_ink" />

        <TextView
            style="@style/T.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="@string/inc_accept_long"
            android:textColor="@color/call_ink"
            android:textSize="26sp" />
    </LinearLayout>
</LinearLayout>
