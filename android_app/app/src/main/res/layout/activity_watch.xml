<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/watchRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/common_back"
                android:padding="12dp"
                app:srcCompat="@drawable/ic_arrow_left"
                app:tint="@color/ink" />

            <TextView
                style="@style/T.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/watch_title" />

            <com.aegis.saathi.ui.LanguageToggle
                android:id="@+id/langToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            style="@style/T.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/watch_sub" />

        <!-- Status card -->
        <LinearLayout
            android:id="@+id/statusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp">

                    <View
                        android:id="@+id/pulseRing"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_circle_primary_soft" />

                    <ImageView
                        android:id="@+id/ivWatchBig"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:importantForAccessibility="no"
                        android:padding="16dp"
                        app:srcCompat="@drawable/ic_watch"
                        app:tint="@color/primary" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvLinkTitle"
                        style="@style/T.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/tvLinkDevice"
                        style="@style/T.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_steps"
                        app:tint="@color/ink_soft" />

                    <TextView
                        android:id="@+id/wSteps"
                        style="@style/T.Metric"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        style="@style/T.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/metric_steps" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_heart"
                        app:tint="@color/bad" />

                    <TextView
                        android:id="@+id/wHr"
                        style="@style/T.Metric"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        style="@style/T.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/metric_heart" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_drop"
                        app:tint="@color/primary" />

                    <TextView
                        android:id="@+id/wSpo2"
                        style="@style/T.Metric"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        style="@style/T.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/metric_oxygen" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_battery"
                        app:tint="@color/good" />

                    <TextView
                        android:id="@+id/wBattery"
                        style="@style/T.Metric"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        style="@style/T.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/metric_battery" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvLastReading"
                style="@style/T.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnScan"
                    style="@style/T.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
            android:minHeight="56dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_primary"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnDisconnect"
                    style="@style/T.ButtonDark"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
            android:minHeight="56dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/watch_disconnect"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnForget"
                style="@style/T.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
            android:minHeight="56dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/watch_forget"
                android:textColor="@color/bad"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Notice (permission / Bluetooth off / no BLE) -->
        <LinearLayout
            android:id="@+id/noticeBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_tile_warn"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_warning"
                    app:tint="@color/warn" />

                <TextView
                    android:id="@+id/tvNotice"
                    style="@style/T.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:textColor="@color/ink" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnFix"
                style="@style/T.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
            android:minHeight="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_btn_primary"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Devices found -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/T.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/watch_found" />

            <CheckBox
                android:id="@+id/cbShowAll"
                style="@style/T"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/watch_show_all"
                android:textColor="@color/ink_soft"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/deviceList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvNoDevices"
            style="@style/T.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/watch_none_found" />

        <!-- Demo (emulators / testing) -->
        <TextView
            android:id="@+id/btnDemo"
            style="@style/T.ButtonDark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_btn_outline"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/watch_demo_btn"
            android:textSize="18sp" />

        <TextView
            style="@style/T.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/watch_demo_on" />

        <TextView
            style="@style/T.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/watch_always_on" />

        <!-- Developer: raw data -->
        <TextView
            android:id="@+id/rawToggle"
            style="@style/T.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="8dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/watch_raw_title"
            android:textColor="@color/primary" />

        <LinearLayout
            android:id="@+id/rawBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                style="@style/T.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/watch_raw_hint" />

            <TextView
                android:id="@+id/tvRawLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:textColor="@color/ink_soft"
                android:textIsSelectable="true"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
